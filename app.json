{
  "expo": {
    "name": "RecipeTempo",
    "slug": "recipetempo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/recipeTempologo.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/recipeTempologo.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF6F0"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.recipetempo"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FAF6F0"
      },
      "package": "com.anonymous.recipetempo"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "publicPath": "/recipetempo/"
    },
    "plugins": [
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-2400579557711506~5880054197",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "2.1.20",
            "kspVersion": "2.1.20"
          }
        }
      ]
    ]
  }
}